# Konfigurasi Koneksi Database PostgreSQL / PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nusagis
DB_USER=postgres
DB_PASSWORD=your_password_here

# Opsional: Connection String URL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nusagis


# Autentikasi
# Kunci penandatangan token sesi, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# Opsional: origin tambahan yang diizinkan untuk request yang mengubah data (pisahkan dengan koma)
# APP_ALLOWED_ORIGINS=https://gis.perusahaan.co.id

# Setup admin pertama (npm run admin:create). Isi sementara, lalu hapus setelah admin dibuat.
# Jika dikosongkan, script akan menanyakan secara interaktif.
# ADMIN_NAMA=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
