# Konfigurasi Database PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nusagis
DB_USER=postgres
DB_PASSWORD=ganti_password_database_anda

# Atau gunakan satu URL koneksi penuh:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nusagis

# Kunci rahasia JWT HS256 (WAJIB minimal 32 karakter acak)
SESSION_SECRET=ganti_dengan_minimal_32_karakter_acak_rahasia_pt_rpn_2026

# Set ke false jika deploy produksi pada jaringan lokal/IP HTTP belum memakai SSL/HTTPS
# Set ke true jika sudah menggunakan domain HTTPS
COOKIE_SECURE=true

# Daftar origin yang diizinkan untuk proteksi CSRF (pisahkan dengan koma jika lebih dari satu)
# APP_ALLOWED_ORIGINS=https://gis.rpn.co.id
